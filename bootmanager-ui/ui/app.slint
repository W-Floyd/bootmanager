// The boot manager: a carousel of boot entries (carousel.slint), and a menu
// that slides up over it (menu.slint) for everything else. What is in them
// and what each does is src/app.rs's and src/screens.rs's; this only draws.
//
// Sizes are logical pixels, about 0.19 mm each; the scale factor comes from
// the panel (src/app.rs, scale_for).

import "DejaVuSans.ttf";
import "DejaVuSans-Bold.ttf";
import { Palette, Card, Row } from "theme.slint";
import { MenuList } from "menu.slint";
import { Carousel } from "carousel.slint";

export { Card, Row }

// The top line: with no cutout, one line; with some, a line as tall as
// they reach, its text left of them, as phosh lays out its top bar.
component TopLine {
    in property <string> text;
    in property <color> color;
    in property <length> cutout-x;
    in property <length> cutout-h;
    in property <length> side-pad;
    height: root.cutout-h > 0 ? max(root.cutout-h, 24px) : 16px;
    Text {
        x: 0;
        width: root.cutout-h > 0 ? max(0px, root.cutout-x - root.side-pad - 8px) : parent.width;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-size: 12px;
        color: root.color;
        overflow: elide;
    }
}

export component AppWindow inherits Window {
    preferred-width: 360px;
    preferred-height: 800px;
    background: #07080c;
    default-font-family: "DejaVu Sans";
    title: "Boot Manager";

    // The device tree's name for the device.
    in property <string> model;
    // The panel's shape (display.info): the span of the cutouts near the
    // top edge, how far down the lowest reaches, and the corner radius.
    in property <length> cutout-x;
    in property <length> cutout-w;
    in property <length> cutout-h;
    in property <length> corner-radius;
    // Clear of the rounded corners: half the radius covers text a line
    // down from the top edge.
    property <length> side-pad: max(18px, root.corner-radius / 2);
    in property <string> busy;

    // The carousel.
    in property <[Card]> cards;
    in-out property <int> card-selected;
    in property <bool> revealed;
    in property <int> launching: -1;
    in property <int> remaining: -1;
    in property <int> total: 10;
    // Errors and "waiting for the backend", over the carousel.
    in property <string> toast;
    in property <string> home-hint: "▲▼ choose  ·  Power start  ·  hold for menu";
    callback card-activated(int);
    callback open-menu();

    // The menu.
    in property <bool> menu-open;
    in property <string> heading: "Boot Manager";
    in property <bool> compact;
    in property <string> subheading;
    in property <string> status;
    in property <string> hint: "▲▼ move  ·  Power select  ·  or tap";
    in property <[Row]> rows;
    in-out property <int> selected;
    callback activated(int);
    callback back();
    callback activity();

    forward-focus: carousel;
    public function focus-home() {
        carousel.focus();
    }
    public function focus-menu() {
        list.focus();
    }
    public function scroll-to-selected() {
        list.show-selected();
    }

    // The backdrop takes the colour of the card in the middle.
    property <color> tint: root.cards.length > 0 ? root.cards[root.card-selected].a : #3a3f7a;
    animate tint { duration: 700ms; easing: ease-in-out; }
    Rectangle {
        background: @linear-gradient(170deg, root.tint.mix(#10121c, 0.35) 0%, root.tint.mix(#0b0c14, 0.12) 50%, #07080c 100%);
    }
    // A glow behind the cards, in a square: the circle's radius reaches
    // the square's corners, so fading out by 68% of it (under half the
    // side) keeps it off every edge, whatever the window's shape.
    Rectangle {
        width: min(root.width, root.height);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: @radial-gradient(circle, root.tint.transparentize(0.7) 0%, root.tint.transparentize(1) 68%);
    }

    // Behind everything: a touch anywhere stops the autoboot.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.activity();
            }
        }
    }

    // --- home: the carousel ---

    property <bool> chrome: root.revealed && root.launching < 0;
    home := Rectangle {
        opacity: root.menu-open ? 0.2 : 1;
        animate opacity { duration: 350ms; }

        header := VerticalLayout {
            y: root.chrome ? 0 : -30px;
            animate y { duration: 700ms; easing: ease-out-back; }
            opacity: root.chrome ? 1 : 0;
            animate opacity { duration: 500ms; }
            padding-left: root.side-pad;
            padding-right: root.side-pad;
            padding-top: root.cutout-h > 0 ? 0 : 14px;
            spacing: 2px;
            height: self.preferred-height;
            TopLine {
                text: root.model;
                color: #ffffffb0;
                cutout-x: root.cutout-x;
                cutout-h: root.cutout-h;
                side-pad: root.side-pad;
            }
            Text {
                text: "Choose a system";
                font-size: 26px;
                font-weight: 700;
                color: #ffffff;
            }
        }

        // Errors and the like, in a pill that drops in.
        Rectangle {
            property <bool> shown: root.toast != "" && root.launching < 0;
            x: (parent.width - self.width) / 2;
            y: header.height + (self.shown ? 12px : -12px);
            animate y { duration: 450ms; easing: ease-out-back; }
            width: min(parent.width - 32px, toast-text.preferred-width + 32px);
            height: toast-text.preferred-height + 16px;
            border-radius: self.height / 2;
            background: #00000080;
            border-width: 1px;
            border-color: Palette.alert.transparentize(0.5);
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 250ms; }
            toast-text := Text {
                width: parent.width - 32px;
                text: root.toast;
                font-size: 13px;
                color: Palette.alert;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        carousel := Carousel {
            band-y: header.height;
            band-h: root.height - header.height - 90px;
            cards: root.cards;
            selected <=> root.card-selected;
            revealed: root.revealed;
            launching: root.launching;
            remaining: root.remaining;
            total: root.total;
            note: root.busy;
            activated(i) => { root.card-activated(i); }
            activity => { root.activity(); }
            menu => { root.open-menu(); }
        }

        // One dot per card; the current one a pill.
        HorizontalLayout {
            y: root.height - 78px;
            height: 8px;
            alignment: center;
            spacing: 6px;
            opacity: root.chrome ? 1 : 0;
            animate opacity { duration: 500ms; delay: 300ms; }
            for c[i] in root.cards: Rectangle {
                width: i == root.card-selected ? 22px : 8px;
                animate width { duration: 450ms; easing: ease-out-back; }
                border-radius: 4px;
                background: i == root.card-selected ? #ffffff : #ffffff55;
                animate background { duration: 300ms; }
            }
        }

        Text {
            y: root.height - 44px;
            width: parent.width;
            horizontal-alignment: center;
            text: root.home-hint;
            font-size: 12px;
            color: #ffffff80;
            opacity: root.chrome ? 1 : 0;
            animate opacity { duration: 500ms; delay: 400ms; }
        }
    }

    // --- the menu, sliding up over the carousel ---

    // A sheet, tinted like the backdrop, its top corners rounded.
    Rectangle {
        y: root.menu-open ? root.cutout-h / 2 : root.height;
        height: root.height - root.cutout-h / 2;
        animate y { duration: 450ms; easing: root.menu-open ? ease-out-quint : ease-in-out; }
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: root.tint.mix(#0c0d14, 0.1);
        // A grip, as sheets have.
        Rectangle {
            y: 8px;
            width: 36px;
            height: 4px;
            border-radius: 2px;
            background: #ffffff30;
        }

        VerticalLayout {
            Rectangle {
                // Its content's height, no more.
                vertical-stretch: 0;
                VerticalLayout {
                    padding-left: root.side-pad;
                    padding-right: root.side-pad;
                    padding-top: 22px;
                    padding-bottom: 12px;
                    spacing: 4px;
                    Text {
                        text: root.heading;
                        font-size: 26px;
                        font-weight: 700;
                        color: #ffffff;
                        overflow: elide;
                    }
                    if root.subheading != "": Text {
                        text: root.subheading;
                        font-size: 13px;
                        color: Palette.dim;
                        overflow: elide;
                    }
                }
            }

            if root.status != "": Rectangle {
                background: #3a2a10;
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 18px;
                    Text {
                        text: root.status;
                        font-size: 13px;
                        color: Palette.alert;
                        wrap: word-wrap;
                    }
                }
            }

            list := MenuList {
                compact: root.compact;
                vertical-stretch: 1;
                rows: root.rows;
                selected <=> root.selected;
                activated(i) => { root.activated(i); }
                back => { root.back(); }
                activity => { root.activity(); }
            }

            Rectangle {
                height: 40px;
                Text {
                    text: root.hint;
                    font-size: 12px;
                    color: Palette.dim;
                }
            }
        }
    }

    // Busy with something other than a boot (the launch shows its own):
    // a veil that fades in, and swallows touches while it is up.
    Rectangle {
        background: #000000c8;
        opacity: root.busy != "" && root.launching < 0 ? 1 : 0;
        animate opacity { duration: 200ms; }
        visible: self.opacity > 0;
        Text {
            text: root.busy;
            font-size: 20px;
            font-weight: 700;
            color: Palette.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 48px;
        }
        TouchArea { }
    }

    // The first frame fades up from black.
    Rectangle {
        background: #000000;
        opacity: root.revealed ? 0 : 1;
        animate opacity { duration: 600ms; }
        visible: self.opacity > 0;
    }
}
