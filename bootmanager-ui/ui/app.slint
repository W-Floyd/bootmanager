// The boot manager: one screen that is a header, a status line, a list and a
// key hint. The list is the whole UI -- src/screens.rs decides what is in it
// and what each row does.
//
// Sizes are logical pixels, about 0.19 mm each; the scale factor comes from
// the panel (src/platform.rs, scale_for).

import "DejaVuSans.ttf";
import "DejaVuSans-Bold.ttf";

export struct Row {
    title: string,
    detail: string,
    // "nav" (opens a screen), "toggle", "action", "danger", "info", "back"
    kind: string,
    on: bool,
    // A picture at the left (image files in a listing); empty for none.
    thumb: image,
}

global Palette {
    out property <color> bg: #0c100e;
    out property <color> panel: #141a17;
    out property <color> text: #e8efe9;
    out property <color> dim: #8a9a90;
    out property <color> accent: #3ec46d;
    out property <color> select: #1c3325;
    out property <color> alert: #f0a030;
    out property <color> danger: #ef5b5b;
}

component Switch inherits Rectangle {
    in property <bool> on;
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: on ? Palette.accent : #3a423d;
    animate background { duration: 150ms; }
    Rectangle {
        x: on ? parent.width - self.width - 3px : 3px;
        animate x { duration: 150ms; easing: ease-out; }
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
    }
}

component MenuList inherits FocusScope {
    in property <[Row]> rows;
    in-out property <int> selected;
    callback activated(int);
    callback back();
    callback activity();
    // Compact rows for screens of plain lines (the log).
    in property <bool> compact;
    property <length> row-h: compact ? 30px : 64px;
    // Keys ease the list to the selected row; a finger moves it directly.
    property <bool> ease-scroll;

    public function show-selected() {
        // Before the first layout the list has no height: nothing to scroll.
        if (flick.height <= 0) {
            return;
        }
        if (root.selected * root.row-h + flick.content-y < 0) {
            flick.content-y = -root.selected * root.row-h;
        } else if ((root.selected + 1) * root.row-h + flick.content-y > flick.height) {
            flick.content-y = flick.height - (root.selected + 1) * root.row-h;
        }
    }

    changed selected => {
        self.show-selected();
    }

    // Wrapping at both ends: with only two volume keys, the far end of a
    // long list is one press away.
    key-pressed(event) => {
        root.activity();
        root.ease-scroll = true;
        if (event.text == Key.UpArrow) {
            root.selected = root.selected <= 0 ? root.rows.length - 1 : root.selected - 1;
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.selected = root.selected >= root.rows.length - 1 ? 0 : root.selected + 1;
            return accept;
        }
        if (event.text == Key.Return || event.text == " ") {
            if (root.rows.length > 0) {
                root.activated(root.selected);
            }
            return accept;
        }
        if (event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.LeftArrow) {
            root.back();
            return accept;
        }
        reject
    }

    flick := Flickable {
        content-height: root.rows.length * root.row-h;
        animate content-y { duration: root.ease-scroll ? 150ms : 0ms; easing: ease-out; }
        for row[i] in root.rows: Rectangle {
            y: i * root.row-h;
            height: root.row-h;
            // Pressed, then selected, then hovered (a mouse or trackpad; a
            // finger hovers only while down, and the platform ends it on lift).
            background: ta.pressed ? #2a4a36 : i == root.selected ? Palette.select : ta.has-hover ? #16231b : transparent;
            animate background { duration: 100ms; }

            Rectangle {
                x: 0;
                width: 4px;
                background: i == root.selected ? Palette.accent : transparent;
                animate background { duration: 100ms; }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #1d2420;
            }

            if row.thumb.width > 0: Image {
                x: 18px;
                y: 6px;
                width: root.row-h - 12px;
                height: root.row-h - 12px;
                source: row.thumb;
                image-fit: contain;
            }

            VerticalLayout {
                x: row.thumb.width > 0 ? 18px + root.row-h : 18px;
                width: parent.width - self.x - (row.kind == "toggle" ? 72px : row.kind == "nav" ? 40px : 16px);
                alignment: center;
                spacing: 3px;
                Text {
                    text: row.title;
                    font-size: root.compact ? 12px : 17px;
                    color: row.kind == "danger" ? Palette.danger : row.kind == "back" ? Palette.accent : row.kind == "info" ? Palette.dim : Palette.text;
                    overflow: elide;
                }

                if row.detail != "": Text {
                    text: row.detail;
                    font-size: 13px;
                    color: Palette.dim;
                    overflow: elide;
                }
            }

            if row.kind == "toggle": Switch {
                x: parent.width - self.width - 18px;
                y: (parent.height - self.height) / 2;
                on: row.on;
            }

            if row.kind == "nav": Text {
                x: parent.width - 30px;
                y: (parent.height - self.height) / 2;
                text: ">";
                font-size: 17px;
                color: Palette.dim;
            }

            ta := TouchArea {
                mouse-cursor: row.kind == "info" ? MouseCursor.default : MouseCursor.pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.ease-scroll = false;
                    }
                }
                clicked => {
                    root.activity();
                    root.selected = i;
                    root.focus();
                    root.activated(i);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    preferred-width: 360px;
    preferred-height: 800px;
    background: Palette.bg;
    default-font-family: "DejaVu Sans";
    title: "Boot Manager";

    in property <string> heading: "Boot Manager";
    // The device tree's name for the device.
    in property <string> model;
    // The panel's shape (display.info): the span of the cutouts near the
    // top edge, how far down the lowest reaches, and the corner radius.
    in property <length> cutout-x;
    in property <length> cutout-w;
    in property <length> cutout-h;
    in property <length> corner-radius;
    // Clear of the rounded corners: half the radius covers text a line
    // down from the top edge.
    property <length> side-pad: max(18px, root.corner-radius / 2);
    in property <bool> compact;
    in property <string> subheading;
    in property <string> status;
    in property <string> busy;
    in property <string> hint: "▲▼ move  ·  Power select  ·  or tap";
    in property <[Row]> rows;
    in-out property <int> selected;
    callback activated(int);
    callback back();
    callback activity();

    forward-focus: list;

    public function scroll-to-selected() {
        list.show-selected();
    }

    // Behind everything: a touch anywhere stops the autoboot, not only on
    // a row (the rows report their own).
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.activity();
            }
        }
    }

    VerticalLayout {
        Rectangle {
            background: Palette.panel;
            // Its content's height, no more: the cutout's status row is a
            // plain Rectangle, which would otherwise let the header share the
            // spare height with the list.
            vertical-stretch: 0;
            VerticalLayout {
                padding-left: root.side-pad;
                padding-right: root.side-pad;
                padding-top: root.cutout-h > 0 ? 0 : 14px;
                padding-bottom: 12px;
                spacing: 4px;
                // With no cutout, one line. With some, a line as tall as
                // they reach, its text left of them, as phosh lays out its
                // top bar.
                Rectangle {
                    height: root.cutout-h > 0 ? max(root.cutout-h, 24px) : 16px;
                    Text {
                        x: 0;
                        width: root.cutout-h > 0 ? max(0px, root.cutout-x - root.side-pad - 8px) : parent.width;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.model;
                        font-size: 12px;
                        color: Palette.accent;
                        overflow: elide;
                    }
                }

                Text {
                    text: root.heading;
                    font-size: 22px;
                    font-weight: 700;
                    color: Palette.text;
                    overflow: elide;
                }

                if root.subheading != "": Text {
                    text: root.subheading;
                    font-size: 13px;
                    color: Palette.dim;
                    overflow: elide;
                }
            }
        }

        if root.status != "": Rectangle {
            background: #3a2a10;
            HorizontalLayout {
                padding: 12px;
                padding-left: 18px;
                Text {
                    text: root.status;
                    font-size: 13px;
                    color: Palette.alert;
                    wrap: word-wrap;
                }
            }
        }

        list := MenuList {
            compact: root.compact;
            vertical-stretch: 1;
            rows: root.rows;
            selected <=> root.selected;
            activated(i) => { root.activated(i); }
            back => { root.back(); }
            activity => { root.activity(); }
        }

        Rectangle {
            background: Palette.panel;
            height: 40px;
            Text {
                text: root.hint;
                font-size: 12px;
                color: Palette.dim;
            }
        }
    }

    // Always there, so it can fade in; hidden (and letting touches
    // through) once faded out.
    Rectangle {
        background: #000000c8;
        opacity: root.busy != "" ? 1 : 0;
        animate opacity { duration: 150ms; }
        visible: self.opacity > 0;
        Text {
            text: root.busy;
            font-size: 20px;
            font-weight: 700;
            color: Palette.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 48px;
        }
        // Swallows touches while an action runs.
        TouchArea { }
    }
}
