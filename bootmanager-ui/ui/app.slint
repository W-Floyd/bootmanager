// The boot manager: a carousel of boot entries (carousel.slint), and a menu
// that slides up over it (menu.slint) for everything else. What is in them
// and what each does is src/app.rs's and src/screens.rs's; this only draws.
//
// Sizes are logical pixels, about 0.19 mm each; the scale factor comes from
// the panel (src/app.rs, scale_for).

import "DejaVuSans.ttf";
import "DejaVuSans-Bold.ttf";
import { Palette, Card, Row } from "theme.slint";
import { MenuList } from "menu.slint";
import { Keyboard, VirtualKeyboardHandler } from "keyboard.slint";
import { Carousel } from "carousel.slint";
import { Splash } from "splash.slint";
import { UnlockWindow } from "unlock.slint";
import { BatteryIndicator } from "battery.slint";

export { Card, Row, VirtualKeyboardHandler, UnlockWindow }

// The top line: with no cutout, one line; with some, a line as tall as
// they reach, its text left of them, as phosh lays out its top bar.
export component AppWindow inherits Window {
    preferred-width: 360px;
    preferred-height: 800px;
    background: #07080c;
    default-font-family: "DejaVu Sans";
    title: "Boot Manager";

    // The device tree's name for the device.
    in property <string> model;
    // The panel's shape (display.info): how far down the lowest of the
    // cutouts near the top edge reaches, and the corner radius.
    in property <length> cutout-h;
    in property <length> corner-radius;
    // Clear of the rounded corners: half the radius covers text a line
    // down from the top edge.
    property <length> side-pad: max(18px, root.corner-radius / 2);
    in property <string> busy;
    // The battery indicator, top right, while there is a battery.
    in property <bool> battery-present;
    in property <int> battery-percent: -1;
    in property <bool> battery-charging;

    // The carousel.
    in property <[Card]> cards;
    in-out property <int> card-selected;
    // Up from black (started), then the splash until the carousel's
    // entrance (revealed).
    in property <bool> started;
    in property <bool> revealed;
    in property <int> launching: -1;
    in property <int> remaining: -1;
    in property <int> total: 10;
    // Errors and "waiting for the backend", over the carousel.
    in property <string> toast;
    in property <string> home-hint: "▲▼ choose  ·  Power start  ·  hold for menu";
    callback card-activated(int);
    in property <int> default-index;
    in property <bool> default-explicit;
    in-out property <int> card-editing: -1;
    callback card-move(int, int);
    callback card-default(int);
    callback open-menu();

    // The menu.
    in property <bool> menu-open;
    in property <string> heading: "Boot Manager";
    in property <bool> compact;
    in property <string> subheading;
    in property <string> status;
    in property <string> hint: "▲▼ move  ·  Power select  ·  or tap";
    in property <[Row]> rows;
    in-out property <int> selected;
    callback activated(int);
    // A passphrase field under the heading while a screen asks for one
    // (text-entry), and the keyboard under the list while it has focus
    // (keyboard.slint). Return in the field is `passphrase-accepted`.
    in property <bool> text-entry;
    in-out property <string> passphrase;
    callback passphrase-accepted();
    callback back();
    callback close-menu();
    callback activity();

    // The image viewer, over the menu: an image fitted to the screen, or
    // why there is none yet.
    in property <bool> viewing;
    in property <image> picture;
    in property <string> picture-note;

    forward-focus: carousel;
    public function focus-home() {
        carousel.focus();
    }
    public function focus-menu() {
        list.focus();
    }
    public function focus-viewer() {
        viewer.focus();
    }
    public function scroll-to-selected() {
        list.show-selected();
    }

    // The backdrop takes the colour of the card in the middle.
    property <color> tint: root.cards.length > 0 ? root.cards[root.card-selected].a : #3a3f7a;
    animate tint { duration: 700ms; easing: ease-in-out; }
    Rectangle {
        background: @linear-gradient(180deg, root.tint.mix(#10121c, 0.35) 0%, root.tint.mix(#0b0c14, 0.12) 50%, #07080c 100%);
    }

    // The splash until the entrance; gone once faded, so its animation
    // stops asking for frames.
    property <float> splash-o: root.revealed ? 0 : 1;
    animate splash-o { duration: 500ms; }
    if root.splash-o > 0: Splash {
        opacity: root.splash-o;
    }

    // Behind everything: a touch anywhere stops the autoboot.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.activity();
            }
        }
    }

    // --- home: the carousel ---

    property <bool> chrome: root.revealed && root.launching < 0;
    home := Rectangle {
        opacity: root.menu-open ? 0.2 : 1;
        animate opacity { duration: 350ms; }
        // Hidden under the open sheet: nothing there to see, and the
        // software renderer, repainting a row, draws the translucent
        // cards past the damaged area and over the sheet.
        visible: sheet.y > root.cutout-h / 2;

        header := VerticalLayout {
            y: root.chrome ? 0 : -30px;
            animate y { duration: 700ms; easing: cubic-bezier(0.34, 1.2, 0.64, 1); }
            opacity: root.chrome ? 1 : 0;
            animate opacity { duration: 500ms; }
            padding-left: root.side-pad;
            padding-right: root.side-pad;
            padding-top: root.cutout-h > 0 ? 0 : 14px;
            spacing: 2px;
            height: self.preferred-height;
            // Clear of the cutouts near the top edge.
            Rectangle {
                height: root.cutout-h > 0 ? max(root.cutout-h, 24px) : 16px;
            }
            Text {
                text: "Choose a system";
                font-size: 26px;
                font-weight: 700;
                color: #ffffff;
            }
            Text {
                text: root.model;
                font-size: 13px;
                color: #ffffffb0;
                overflow: elide;
            }
        }

        // Top right, in the band the title leaves clear.
        if root.battery-present: BatteryIndicator {
            x: parent.width - self.width - root.side-pad;
            y: root.cutout-h > 0 ? 4px : 12px;
            percent: root.battery-percent;
            charging: root.battery-charging;
            opacity: header.opacity;
        }

        // Errors and the like, in a pill that drops in.
        Rectangle {
            property <bool> shown: root.toast != "" && root.launching < 0;
            x: (parent.width - self.width) / 2;
            y: header.height + (self.shown ? 12px : -12px);
            animate y { duration: 450ms; easing: cubic-bezier(0.34, 1.2, 0.64, 1); }
            width: min(parent.width - 32px, toast-text.preferred-width + 32px);
            height: toast-text.preferred-height + 16px;
            border-radius: self.height / 2;
            background: #00000080;
            border-width: 1px;
            border-color: Palette.alert.transparentize(0.5);
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 250ms; }
            toast-text := Text {
                width: parent.width - 32px;
                text: root.toast;
                font-size: 13px;
                color: Palette.alert;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        carousel := Carousel {
            band-y: header.height;
            band-h: root.height - header.height - 90px;
            cards: root.cards;
            selected <=> root.card-selected;
            revealed: root.revealed;
            launching: root.launching;
            remaining: root.remaining;
            total: root.total;
            note: root.busy;
            activated(i) => { root.card-activated(i); }
            activity => { root.activity(); }
            menu => { root.open-menu(); }
            default-index: root.default-index;
            default-explicit: root.default-explicit;
            editing <=> root.card-editing;
            move(i, by) => { root.card-move(i, by); }
            make-default(i) => { root.card-default(i); }
        }

        // One dot per card; the current one a pill.
        HorizontalLayout {
            y: root.height - 78px;
            height: 8px;
            alignment: center;
            spacing: 6px;
            opacity: root.chrome ? 1 : 0;
            animate opacity { duration: 500ms; delay: 300ms; }
            for c[i] in root.cards: Rectangle {
                width: i == root.card-selected ? 22px : 8px;
                animate width { duration: 450ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                border-radius: 4px;
                background: i == root.card-selected ? #ffffff : #ffffff55;
                animate background { duration: 300ms; }
            }
        }

        Text {
            y: root.height - 44px;
            width: parent.width;
            horizontal-alignment: center;
            text: carousel.editing >= 0 ? "▲▼ move  ·  Power default  ·  hold Power: done" : root.home-hint;
            font-size: 12px;
            color: #ffffff80;
            opacity: root.chrome ? 1 : 0;
            animate opacity { duration: 500ms; delay: 400ms; }
        }
    }

    // --- the menu, sliding up over the carousel ---

    // A sheet, tinted like the backdrop, its top corners rounded, that
    // the grip and heading drag down.
    // The fraction open animates, not the position: a window taking its
    // size (the page loading) moves a closed sheet without a slide.
    property <float> open-t: root.menu-open ? 1 : 0;
    animate open-t { duration: 450ms; easing: root.menu-open ? ease-out-quint : ease-in-out; }
    property <length> sheet-y: root.height - (root.height - root.cutout-h / 2) * root.open-t;
    property <length> pull;
    // Only a pull let go short of closing eases back; a closing one stays
    // put so the sheet slides on from where it was dropped.
    property <bool> spring;
    animate pull { duration: root.spring ? 300ms : 0ms; easing: ease-out; }
    changed menu-open => {
        if (root.menu-open) {
            root.spring = false;
            root.pull = 0;
        }
    }
    sheet := Rectangle {
        y: root.sheet-y + root.pull;
        height: root.height - root.cutout-h / 2;
        border-top-left-radius: 22px;
        border-top-right-radius: 22px;
        background: root.tint.mix(#0c0d14, 0.1);
        // A grip, as sheets have.
        Rectangle {
            y: 8px;
            width: 36px;
            height: 4px;
            border-radius: 2px;
            background: #ffffff30;
        }

        VerticalLayout {
            head := Rectangle {
                // Its content's height, no more: a plain Rectangle in a
                // layout lifts its parent's height limit.
                vertical-stretch: 0;
                VerticalLayout {
                    padding-left: root.side-pad;
                    padding-right: root.side-pad;
                    padding-top: 22px;
                    padding-bottom: 12px;
                    spacing: 4px;
                    Text {
                        text: root.heading;
                        font-size: 26px;
                        font-weight: 700;
                        color: #ffffff;
                        overflow: elide;
                    }
                    if root.subheading != "": Text {
                        text: root.subheading;
                        font-size: 13px;
                        color: Palette.dim;
                        overflow: elide;
                    }
                }
            }

            if root.status != "": Rectangle {
                background: #3a2a10;
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 18px;
                    Text {
                        text: root.status;
                        font-size: 13px;
                        color: Palette.alert;
                        wrap: word-wrap;
                    }
                }
            }

            if root.text-entry: entry := FocusScope {
                vertical-stretch: 0;
                height: 56px;
                forward-focus: field;
                init => { field.focus(); }
                // The volume keys, the only keys some phones have, would
                // only move the cursor here: they leave the screen, so
                // the field is never a trap.
                capture-key-pressed(event) => {
                    root.activity();
                    if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Escape) {
                        root.back();
                        return accept;
                    }
                    reject
                }
                Rectangle {
                    x: root.side-pad;
                    width: parent.width - 2 * root.side-pad;
                    height: 48px;
                    border-radius: 10px;
                    background: #ffffff14;
                    border-width: 1px;
                    border-color: field.has-focus ? Palette.accent : #ffffff20;
                    if root.passphrase == "": Text {
                        x: 14px;
                        text: "Passphrase";
                        font-size: 18px;
                        color: #ffffff60;
                        vertical-alignment: center;
                    }
                    field := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        text <=> root.passphrase;
                        input-type: InputType.password;
                        single-line: true;
                        font-size: 20px;
                        color: #ffffff;
                        vertical-alignment: center;
                        accepted => { root.passphrase-accepted(); }
                    }
                }
            }

            list := MenuList {
                compact: root.compact;
                vertical-stretch: 1;
                rows: root.rows;
                selected <=> root.selected;
                activated(i) => { root.activated(i); }
                back => { root.back(); }
                activity => { root.activity(); }
            }

            if TextInputInterface.text-input-focused: Keyboard { }

            Rectangle {
                height: 40px;
                Text {
                    text: root.hint;
                    font-size: 12px;
                    color: Palette.dim;
                }
            }
        }

        // The menu has it too, top right of its heading.
        if root.battery-present: BatteryIndicator {
            x: parent.width - self.width - root.side-pad;
            y: 26px;
            percent: root.battery-percent;
            charging: root.battery-charging;
        }

        // Over the heading only, so the list below still scrolls.
        SwipeGestureHandler {
            y: 0;
            height: head.height;
            handle-swipe-down: true;
            // It sees only what a child would get: with none, nothing.
            TouchArea { }
            moved => {
                root.activity();
                root.spring = false;
                // Positions are the handler's, and it moves with the sheet:
                // add the pull it has already moved by.
                root.pull = max(0, root.pull + self.current-position.y - self.pressed-position.y);
            }
            swiped => {
                if (root.pull > root.height / 4) {
                    root.close-menu();
                } else {
                    root.spring = true;
                    root.pull = 0;
                }
            }
            cancelled => {
                root.spring = true;
                root.pull = 0;
            }
        }
    }

    // Any key or a tap goes back to the file.
    viewer := FocusScope {
        visible: root.viewing;
        key-pressed(event) => {
            root.activity();
            root.back();
            accept
        }
        Rectangle { background: #000000; }
        // Sized, or it takes the picture's pixels as logical ones.
        Image {
            width: 100%;
            height: 100%;
            source: root.picture;
            image-fit: contain;
        }
        Text {
            text: root.picture-note;
            font-size: 15px;
            color: Palette.dim;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 48px;
        }
        TouchArea {
            clicked => {
                root.activity();
                root.back();
            }
        }
    }

    // Busy with something other than a boot (the launch shows its own):
    // a veil that fades in, and swallows touches while it is up.
    Rectangle {
        background: #000000c8;
        opacity: root.busy != "" && root.launching < 0 ? 1 : 0;
        animate opacity { duration: 200ms; }
        visible: self.opacity > 0;
        Text {
            text: root.busy;
            font-size: 20px;
            font-weight: 700;
            color: Palette.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            width: parent.width - 48px;
        }
        TouchArea { }
    }

    // The first frame fades up from black.
    Rectangle {
        background: #000000;
        opacity: root.started ? 0 : 1;
        animate opacity { duration: 600ms; }
        visible: self.opacity > 0;
    }
}
