// The battery indicator: a small cell filled to the charge, with the
// percentage and, while charging, a lightning bolt on it. The fill is a deep
// tone (green charging, amber below 30 %, red below 15, grey otherwise) so
// the white label reads on it at any level, over the fill or the dark.

import { Palette } from "theme.slint";

export component BatteryIndicator inherits Rectangle {
    // 0 to 100, -1 when the level is unknown.
    in property <int> percent;
    in property <bool> charging;
    property <color> ink: #ffffffc0;
    property <color> base: root.charging ? Palette.accent : root.percent >= 0 && root.percent <= 15 ? Palette.danger : root.percent >= 0 && root.percent <= 30 ? Palette.alert : #aab4bd;
    // Kept bright, so the level reads at a glance; the label has its own
    // dark backing, so white is clear on any fill.
    property <color> fill: root.base;

    width: 36px + 2px;
    height: 17px;

    // The cell.
    Rectangle {
        width: 36px;
        height: 17px;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: root.ink;
        background: #00000070;
        clip: true;
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: max(0px, (parent.width - 3px) * (max(0, min(100, root.percent)) / 100));
            height: parent.height - 3px;
            border-radius: 2.5px;
            background: root.fill;
        }
        // The label on a dark backing, centred on the cell.
        Rectangle {
            width: label.preferred-width + 6px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 1.5px;
            border-radius: 3px;
            // Translucent, so the fill still shows through the level.
            background: #00000099;
            label := HorizontalLayout {
                x: 3px;
                spacing: 1px;
                if root.charging: Path {
                    width: 7px;
                    y: (parent.height - self.height) / 2;
                    height: 10px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M 14 1 L 4 14 L 11 14 L 9 23 L 20 9 L 13 9 Z";
                    fill: #ffffff;
                }
                Text {
                    text: root.percent >= 0 ? root.percent + "" : "?";
                    font-size: 11px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                }
            }
        }
    }
    // The terminal, touching the cell.
    Rectangle {
        x: 36px;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 6px;
        border-radius: 1px;
        background: root.ink;
    }
}
