// The battery indicator: a small cell filled to the charge, with the
// percentage and, while charging, a lightning bolt on it. The fill is a deep
// tone (green charging, amber below 30 %, red below 15, grey otherwise) so
// the white label reads on it at any level, over the fill or the dark.

import { Palette } from "theme.slint";

export component BatteryIndicator inherits Rectangle {
    // 0 to 100, -1 when the level is unknown.
    in property <int> percent;
    in property <bool> charging;
    property <color> ink: #ffffffc0;
    property <color> base: root.charging ? Palette.accent : root.percent >= 0 && root.percent <= 15 ? Palette.danger : root.percent >= 0 && root.percent <= 30 ? Palette.alert : #aab4bd;
    // Deep enough that the white label reads on it with no backing: a
    // backing box hid the level, and software rendering has no shadow to
    // lift the text instead.
    property <color> fill: root.base.darker(0.45);

    width: 36px + 2px;
    height: 17px;

    // The cell.
    Rectangle {
        width: 36px;
        height: 17px;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: root.ink;
        background: #00000070;
        clip: true;
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: max(0px, (parent.width - 3px) * (max(0, min(100, root.percent)) / 100));
            height: parent.height - 3px;
            border-radius: 2.5px;
            background: root.fill;
        }
        // The label, centred on the cell: the layout fills it and packs the
        // bolt and the digits in the middle.
        HorizontalLayout {
            alignment: center;
            spacing: 1px;
            if root.charging: Path {
                width: 7px;
                height: 10px;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 14 1 L 4 14 L 11 14 L 9 23 L 20 9 L 13 9 Z";
                fill: #ffffff;
            }
            Text {
                text: root.percent >= 0 ? root.percent + "" : "?";
                font-size: 11px;
                font-weight: 700;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    // The terminal, touching the cell.
    Rectangle {
        x: 36px;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 6px;
        border-radius: 1px;
        background: root.ink;
    }
}
