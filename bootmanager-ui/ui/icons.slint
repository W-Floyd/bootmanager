// Monochrome icons on a 24x24 grid, each cut-out wound against the shape
// it is cut from: the software renderer fills non-zero, whatever
// fill-rule says.
//
// The pmOS logo is postmarketOS's (CC-BY-SA-4.0,
// gitlab.postmarketos.org/postmarketOS/artwork, logo/logo.svg at
// 6b3ffc4caaad75e8c00113480d008576894f21df), fitted to the grid. The
// Android head is Google's (developer.android.com/static/images/brand/
// android-head_flat.svg: the Android robot is reproduced or modified from
// work created and shared by Google and used according to terms described
// in the Creative Commons 3.0 Attribution License), in its own units. The
// rest are drawn for this.

export component Icon {
    in property <string> name;
    in property <brush> color: #ffffff;

