// Monochrome icons on a 24x24 grid, cut-outs by even-odd fill. The pmOS
// logo is postmarketOS's (CC-BY-SA-4.0,
// gitlab.postmarketos.org/postmarketOS/artwork, logo/logo.svg at
// 6b3ffc4caaad75e8c00113480d008576894f21df), fitted to the grid; the rest
// are drawn for this.

export component Icon {
    in property <string> name;
    in property <brush> color: #ffffff;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.color;
        fill-rule: evenodd;
        commands: root.name == "pmos"
            ? "M 9.05 17.79 L 10.61 19.66 L 9.05 21.53 L 23.00 21.53 L 19.76 15.92 L 17.36 15.49 L 16.52 17.79 Z M 15.74 16.43 L 16.57 14.14 L 18.98 14.56 L 12.00 2.47 L 8.76 8.08 L 9.60 10.38 L 12.00 9.95 Z M 11.22 11.31 L 8.81 11.73 L 7.98 9.44 L 1.00 21.53 L 7.48 21.53 L 9.05 19.66 L 7.48 17.79 Z"
            : root.name == "android"
            ? "M 5 13 A 7 7 0 0 1 19 13 Z M 8.6 10 A 0.9 0.9 0 1 0 10.4 10 A 0.9 0.9 0 1 0 8.6 10 Z M 13.6 10 A 0.9 0.9 0 1 0 15.4 10 A 0.9 0.9 0 1 0 13.6 10 Z M 7.6 7.4 L 5.9 4.6 L 6.8 4.1 L 8.5 6.9 Z M 16.4 7.4 L 18.1 4.6 L 17.2 4.1 L 15.5 6.9 Z M 5 14 L 19 14 L 19 19 A 2 2 0 0 1 17 21 L 7 21 A 2 2 0 0 1 5 19 Z M 1.8 14.8 A 1.3 1.3 0 0 1 4.4 14.8 L 4.4 18.6 A 1.3 1.3 0 0 1 1.8 18.6 Z M 19.6 14.8 A 1.3 1.3 0 0 1 22.2 14.8 L 22.2 18.6 A 1.3 1.3 0 0 1 19.6 18.6 Z"
            : root.name == "linux"
            ? "M 12 1.5 C 8.6 1.5 7.4 4.6 7.4 7.6 C 7.4 10.2 5.2 12.2 4.6 15.4 C 4 18.6 5.8 21.6 8.2 22.2 L 15.8 22.2 C 18.2 21.6 20 18.6 19.4 15.4 C 18.8 12.2 16.6 10.2 16.6 7.6 C 16.6 4.6 15.4 1.5 12 1.5 Z M 12 10.2 C 9.6 10.2 8.4 13 8.4 15.8 C 8.4 18.9 10 20.8 12 20.8 C 14 20.8 15.6 18.9 15.6 15.8 C 15.6 13 14.4 10.2 12 10.2 Z M 9.7 5.8 A 1 1.2 0 1 0 11.5 5.8 A 1 1.2 0 1 0 9.7 5.8 Z M 12.5 5.8 A 1 1.2 0 1 0 14.3 5.8 A 1 1.2 0 1 0 12.5 5.8 Z M 10.5 8.1 L 13.5 8.1 L 12 9.6 Z"
            : root.name == "recovery"
            ? "M 12 2 L 20 5 L 20 11 C 20 16.5 16.5 20.5 12 22 C 7.5 20.5 4 16.5 4 11 L 4 5 Z M 10.8 7.5 L 13.2 7.5 L 13.2 10.8 L 16.5 10.8 L 16.5 13.2 L 13.2 13.2 L 13.2 16.5 L 10.8 16.5 L 10.8 13.2 L 7.5 13.2 L 7.5 10.8 L 10.8 10.8 Z"
            : root.name == "gear"
            ? "M 20.00 10.21 L 22.51 10.59 L 22.51 13.41 L 20.00 13.79 L 18.92 16.39 L 20.43 18.43 L 18.43 20.43 L 16.39 18.92 L 13.79 20.00 L 13.41 22.51 L 10.59 22.51 L 10.21 20.00 L 7.61 18.92 L 5.57 20.43 L 3.57 18.43 L 5.08 16.39 L 4.00 13.79 L 1.49 13.41 L 1.49 10.59 L 4.00 10.21 L 5.08 7.61 L 3.57 5.57 L 5.57 3.57 L 7.61 5.08 L 10.21 4.00 L 10.59 1.49 L 13.41 1.49 L 13.79 4.00 L 16.39 5.08 L 18.43 3.57 L 20.43 5.57 L 18.92 7.61 Z M 15.5 12 A 3.5 3.5 0 1 0 8.5 12 A 3.5 3.5 0 1 0 15.5 12 Z"
            : "M 12 3 L 21 8 L 12 13 L 3 8 Z M 3 12 L 5.2 10.8 L 12 14.6 L 18.8 10.8 L 21 12 L 12 17 Z M 3 16 L 5.2 14.8 L 12 18.6 L 18.8 14.8 L 21 16 L 12 21 Z";
    }
}
